{%- macro autocomplete(user, type) -%}
{%- if user.autocomplete in [type, enum('Gazelle\\Enum\\Autocomplete').everywhere]
    %} data-gazelle-autocomplete="true"{% endif -%}
{%- endmacro %}

{%- macro checked(flag) -%}
{%- if flag %} checked{% endif -%}
{%- endmacro %}

{%- macro disabled(flag) -%}
{%- if flag %} disabled{% endif -%}
{%- endmacro %}

{# used as an additional name in an element class declaration #}
{%- macro hidden(flag) -%}
{%- if flag %} hidden{% endif -%}
{%- endmacro %}

{%- macro class_hidden(flag) -%}
{%- if flag %} class="hidden"{% endif -%}
{%- endmacro %}

{%- macro selected(flag) -%}
{%- if flag %} selected{% endif -%}
{%- endmacro %}
