{% from 'macro/form.twig' import checked, disabled, selected %}
{% from 'macro/torrent.twig' import freeleech %}
{{ header('Edit torrent group "' ~ tgroup.name ~ '"') }}

<div class="thin">
    <div class="header">
        <h2>Edit {{ tgroup.link|raw }}</h2>
    </div>
    <div class="box pad">

    <form class="edit_form" name="torrent_group" action="torrents.php" method="post">
    <div class="tbx tgroup-edit">
        <div class="tbx-label">Name</div>
        <div class="tbx-field">
            <input type="text" name="name" size="50" value="{{ tgroup.name }}"{{
                disabled(not viewer.permitted('torrents_edit')) }}>
        </div>
        <div class="tbx-label">Image</div>
        <div class="tbx-field">
            <input type="text" name="image" size="50" value="{{ tgroup.image }}">
{% if constant('IMAGE_HOST_BANNED') %}
            <br><b>Images hosted on <strong class="important_text">{{ constant('IMAGE_HOST_BANNED')|join(', ') }}
                are not allowed</strong>, please rehost first on one of {{ constant('IMAGE_HOST_RECOMMENDED')|join(', ') }}.</b>
{% endif %}
            <br>If the release has no known official artwork (e.g. jam band live recording), check the following:<br>
            <label><input type="checkbox" name="no_cover_art"{{ checked(tgroup.hasAttr('no-cover-art')) }}> No release cover art</label><br><br>
        </div>
        <div class="tbx-label">Group description</div>
        <div class="tbx-field">
            {{ body.emit|raw }}
        </div>
        <div class="tbx-label">Initial Year</div>
        <div class="tbx-field">
{% if tgroup.categoryName == 'Music' %}
            This relates to the year the album was first issued. Remastered versions may have a more recent year which is specified in the edition information.
{% else  %}
            Year of release/publication
{% endif %}
            <br>
            <input type="text" name="year" size="5" value="{{ tgroup.year }}">
        </div>

{% if tgroup.categoryName == 'Music' %}
        <div class="tbx-label">Release type</div>
        <div class="tbx-field">
            <select id="releasetype" name="releasetype">
{%  for key, value in release_type %}
                <option value="{{ key }}"{{ selected(key == tgroup.releaseType) }}>{{ value }}</option>
{%  endfor %}
            </select>
        </div>
{%  if viewer.permitted('torrents_freeleech') %}
        <div class="tbx-label">Download status</div>
        <div class="tbx-field">
            <b>Note:</b> this affects all present uploads in the group but subsequent uploads will not inherit the value.
            <br>
            <br>
            {{ freeleech(size, unit, leech_type, leech_reason) }}
        </div>
{%  endif %}
{%  if viewer.permitted('torrents_edit_vanityhouse') %}
        <div class="tbx-label">Showcase</div>
        <div class="tbx-field">
            <label><input type="checkbox" name="vanity_house" {{ checked(tgroup.isShowcase) }}/> This group is a Showcase release</label>
        </div>
{%  endif %}
{% endif %}
        <div class="tbx-label">Summary of changes</div>
        <div class="tbx-field">
            A brief explanation of what was changed, for the site log
            <br>
            <input type="text" name="summary" size="70" maxlength="100">
        </div>
        <div class="tbx-label"></div>
        <div class="tbx-field">
            <input type="hidden" name="action" value="tgroup-edit">
            <input type="hidden" name="auth" value="{{ viewer.auth }}">
            <input type="hidden" name="groupid" value="{{ tgroup.id }}">
            <input type="submit" value="Update">
        </div>
    </div>
    </form>

{% if tgroup.categoryName == 'Music' and viewer.permitted('torrents_edit') %}
    <hr class="tbx">

    <h4>Merge with another group</h4>
    <form class="merge_form" name="torrent_group" action="torrents.php" method="post">
    <div class="tbx tgroup-merge">
        <div class="tbx-label">Target ID</div>
        <div class="tbx-field">
            <input type="text" name="targetgroupid" size="6"> example, the <b>nnn</b> in <tt>{{
                constant('SITE_URL') }}/torrents.php?id=<b>nnn</b></tt>
            <p>If this torrent group was created by mistake and a prior group
            exists, this group may be merged into that one. Note: there may be
            some duplicates or trumps that need to be reported as a result.</p>
        </div>

        <div class="tbx-label"></div>
        <div class="tbx-field">
            <input type="hidden" name="action" value="tgroup-merge">
            <input type="hidden" name="auth" value="{{ viewer.auth }}">
            <input type="hidden" name="groupid" value="{{ tgroup.id }}">
            <input type="submit" value="Merge">
        </div>
    </div>
    </form>
    </div>
{% endif %}
</div>
{{ footer() }}
