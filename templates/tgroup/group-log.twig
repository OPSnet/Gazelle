{{ header("History for torrent group " ~ id) }}
<div class="thin">
    <div class="header">
        <h2>{{ tgroup.link|default("Group " ~ tgroup.id)|raw }} › Changelog</h2>
    </div>
    <table>
        <tr class="colhead">
            <td>Date</td>
            <td>Torrent</td>
            <td>User</td>
            <td>Info</td>
        </tr>
{% for entry in log %}
        <tr class="row{{ cycle(['a', 'b'], loop.index0) }}">
            <td>{{ entry.created|date('Y-m-d H:i:s') }}</td>
{%  if entry.torrent_id %}
            <td></td>
{%  else %}
            <td><a href="torrents.php?torrentid={{ entry.id_torrent }}">{{ entry.id_torrent }}</a>
{%      if entry.deleted %} (Deleted)
{%      else %}
{%          if entry.media %} ({{ entry.media }}/{{ entry.format }}/{{ entry.encoding }}){% endif %}
{%      endif %}
            </td>
{%  endif %}
        <td>{{ entry.id_user|user_url }}</td>
        <td>{{ entry.note }}</td>
    </tr>
{% endfor %}
    </table>
</div>
{{ footer() }}
