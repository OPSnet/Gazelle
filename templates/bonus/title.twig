{{ header('Bonus Points - Title', {'js': 'bonus'}) }}
<div class="thin">
    <table>
        <thead>
        <tr>
            <td>
                <a href="bonus.php">Shop</a> › Custom Title, BBCode {% if item.label != 'title-bb-y' %}not {% endif
                %} allowed - {{ item.priceForUser(viewer)|number_format }} Points</td>
        </tr>
        </thead>
        <tbody>
        <tr>
            <td>
                <form name="custom-title-preview" action="bonus.php" method="post">
                    <input type="hidden" name="action" value="purchase">
                    <input type="hidden" name="auth" value="{{ viewer.auth }}">
                    <input type="hidden" name="label" value="{{ item.label }}">
                    <input type="text" style="width: 98%" id="title" name="title" placeholder="Custom Title"
                           maxlength="{{ constant('USER_TITLE_LENGTH') }}">
                    <br><br>
                    <input type="button" id="preview-title" value="Preview">
                    <input type="submit" value="Purchase">
                    <br><br>
                    <div id="preview"></div>
                </form>
            </td>
        </tr>
        </tbody>
    </table>
</div>
{{ footer() }}
