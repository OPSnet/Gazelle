{{ header(user.username ~ ' › Edit Audit Trail') }}
<div class="header">
<h2>{{ user.id|user_url }} › Edit Audit Trail</h2>
<div class="linkbox">
    <a href="?action=audit&amp;edit=1&amp;id={{ user.id }}" class="brackets">Edit</a>
    <a href="?action=audit&amp;id={{ user.id }}" class="brackets">View</a>
</div>
</div>
<div class="pad">
<div class="box thin">
<div class="pad">You are editing one or more events. The final text will be replaced in the earliest
event and the more recent events will be removed from the timeline.</div>
<div class="pad">If you remove the text completely, all the events willl be removed.</div>
<div class="pad">You can click on [Edit] or [View] to abandon any changes.</div>
<form action="" method="post">
{{ note.emit|raw }}
<input type="hidden" name="action" value="audit-edit-handle">
<input type="hidden" name="auth" value="{{ viewer.auth }}">
<input type="hidden" name="id" value="{{ user.id }}">
<input type="hidden" name="id_list" value="{{ id_list }}">
<input type="hidden" name="sig" value="{{ viewer.hashHmac('audit', id_list) }}">
<input type="submit" value="Save">
</form>
</div>

{{ footer() }}
