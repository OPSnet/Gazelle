{{ header(user.username ~ ' › Audit Trail', {'js': 'admin'}) }}

<div class="header">
<h2>{{ user.id|user_url }} › Audit Trail</h2>
{% if viewer.permitted('admin_audit_edit') %}
<div class="linkbox">
{%  if not edit %}
    <a href="?action=audit&amp;edit=1&amp;id={{ user.id }}" class="brackets">Edit</a>
{%  else %}
    <a href="?action=audit&amp;id={{ user.id }}" class="brackets">View</a>
{%  endif %}
</div>
{% endif %}
</div>
{% if edit %}
<form action="">
{% endif %}
{% include 'user/audit-list.twig' with {
        audit_trail : user.auditTrail.fullEventList,
        edit        : edit,
    }
%}
{% if edit %}
<input type="hidden" name="action" value="audit-edit">
<input type="hidden" name="auth" value="{{ viewer.auth }}">
<input type="hidden" name="id" value="{{ user.id }}">
<input type="submit" value="Edit checked">
</form>
{% endif %}

{{ footer() }}
