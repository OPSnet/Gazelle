{% from 'macro/form.twig' import checked %}
{% from 'macro/ipv4.twig' import ip_search %}
{{ header('Login Watch', {'js': 'resolve-ip'}) }}
<div class="thin">
<div class="header">
    <h2>Login Watch Management</h2>
</div>
<div class="linkbox">
    <a href="tools.php?action=ip_ban">IP Address Bans</a>
</div>

{% if nr_ban or nr_clear %}
<div class="pad box">
{%  if nr_ban %}
    IP addresses banned: {{ nr_ban }}
{%  endif %}
{%  if nr_clear %}
    IP addresses cleared: {{ nr_clear }}
{%  endif %}
</div>
{% endif %}

{% for b in watch.activeList(paginator.limit, paginator.offset) %}
{%  set header = watch.header %}
{%  if loop.first %}
{{  paginator.linkbox|raw }}
<form class="manage_form" name="bans" action="" method="post">
<input type="hidden" name="auth" value="{{ viewer.auth }}">
<input type="hidden" name="action" value="login_watch">
<table width="100%">
    <tr class="colhead">
        <td>{{ header.emit('ipaddr')|raw }}</td>
        <td>rDNS</td>
        <td>{{ header.emit('user')|raw }}</td>
        <td>{{ header.emit('attempts')|raw }}</td>
        <td>{{ header.emit('bans')|raw }}</td>
        <td>{{ header.emit('last_attempt')|raw }}</td>
        <td>{{ header.emit('banned_until')|raw }}</td>
        <td>Clear</td>
{%      if viewer.permitted('admin_manage_ipbans') %}
        <td>Ban</td>
{%      endif %}
        <td>Do nothing</td>
    </tr>
{%  endif %}
    <tr class="row{{ cycle(['a', 'b'], loop.index0) }}">
        <td>
            {{ ip_search(b.ipaddr) }}{% if b.banned %}<span title="Banned">&nbsp;⛔</span>{% endif %}
        </td>
        <td>
            <span class="resolve-ipv4" data-ip="{{ b.ipaddr }}">Resolving...</span>
        </td>
        <td>
{%  if b.user_id %}
            {{ b.user_id|user_url }}
{%  else %}
            <i title="no user with this name">{{ b.capture }}</i>
{%  endif %}
        </td>
        <td>{{ b.attempts }}</td>
        <td>{{ b.bans }}</td>
        <td>{{ b.last_attempt|time_diff }}</td>
        <td>{{ b.banned_until|time_diff }}</td>
        <td style="text-align: center">
            <input type="radio" title="clear" name="admin-{{ b.id }}" value="clear">
        </td>
{%  if viewer.permitted('admin_manage_ipbans') %}
        <td style="text-align: center">
            <input type="radio" title="ban" name="admin-{{ b.id }}" value="ban">
        </td>
{%  endif %}
        <td style="text-align: center">
            <input type="radio" title="no change" id="noop-{{ b.id
                }}" name="admin-{{ b.id }}" value="noop" checked>
        </td>
{%  if loop.last %}
{%      if viewer.permitted('admin_manage_ipbans') %}
    <tr>
        <td><br>Ban Reason</td>
        <td colspan="9">
            <br>
            <input type="text" name="reason" size="40">
            <br>When banning, this reason will be recorded for each checked IP address.
        </td>
    </tr>
{%      endif %}
    <tr>
        <td colspan="{{ 9 + (viewer.permitted('admin_manage_ipbans') ? 1 : 0) }}">
            <input type="submit" name="submit" value="Update">
        </td>
    </tr>

</table>
</form>
{%  endif %}
{{  paginator.linkbox|raw }}
{% else %}
<div class="pad box">
    There are no current login watches.
</div>
{% endfor %}
</div>
{{ footer() }}
