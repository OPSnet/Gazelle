{% from 'macro/ipv4.twig' import ip_search %}
{{ header('Tracker IP address history › ' ~ (user ? user.username : "IP address " ~ ipaddr), {'js': 'resolve-ip'}) }}
<div class="thin">
    <div class="header">
{% if user  %}
        <h2><a href="{{ user.location }}">{{ user.username }}</a> › Tracker IP History</h2>
{% else %}
        <h2>IP address {{ ipaddr }} › Tracker IP History</h2>
{% endif %}
    </div>

{% for s in summary %}
{%  if loop.first %}
    <div class="header">
        <h3>Summary</h3>
    </div>
    <table>
        <tr class="colhead">
            <th title="Click on an address to view list of users seen on that address">IP</th>
            <th>CC</th>
            <th>Total</th>
            <th>First Seen</th>
            <th>Last Seen</th>
            <th>ASN</th>
            <th>rDNS</th>
        </tr>
{%  endif %}
{%  set geoip = geoip_data[s.IP] %}
        <tr>
            <td><a href="userhistory.php?action=tracker_ips&amp;ip={{ s.IP }}">{{ s.IP }}</a></td>
            <td>{{ geoip.cc }}</td>
            <td>{{ s.total|number_format }}</td>
            <td>{{ s.first|time_diff }}</td>
            <td>{{ s.last|time_diff }}</td>
            <td>ASN {{ geoip.n }} / {{ geoip.name }}</td>
            <td><span class="resolve-ipv4" data-ip="{{ s.IP }}">Resolving...</span></td>
        </tr>
{%  if loop.last %}
    </table>
{%  endif %}
{% endfor %}

    <div class="header">
        <h3>Detail</h3>
    </div>

{{ paginator.linkbox|raw }}

    <table>
        <tr class="colhead">
{% if user %}
            <th>IP</th>
            <th>CC</th>
            <th>ASN</th>
            <th>rDNS</th>
{% else %}
            <th>Username</th>
{% endif %}
            <th>Torrent</th>
            <th>Time</th>
        </tr>
{% for r in details %}
        <tr class="row{{ cycle(['a', 'b'], loop.index0) }}">
{%- if user %}
{%      set geoip = geoip_data[r.ip] %}
            <td><a href="userhistory.php?action=tracker_ips&amp;ip={{ r.ip }}">{{ r.ip }}</a></td>
            <td>{{ geoip.cc }}</td>
            <td>ASN {{ geoip.n }} / {{ geoip.name }}</td>
            <td><span class="resolve-ipv4" data-ip="{{ r.ip }}">Resolving...</span></td>
{%  else %}
            <td><a href="userhistory.php?action=tracker_ips&amp;userid={{ r.uid }}">{{ r.username }}</a></td>
{%  endif -%}
            <td><a href="torrents.php?torrentid={{ r.fid }}">{{ r.name }}</a></td>
            <td>{{ r.date|time_diff }}</td>
        </tr>
{% endfor %}
    </table>
    {{ paginator.linkbox|raw }}
</div>
{{ footer() }}
