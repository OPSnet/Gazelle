{{ header('IP Address Bans') }}
<div class="header">
    <h2>IP Address Bans</h2>
</div>
<div class="linkbox">
    <a href="tools.php?action=login_watch">Login Watch</a>
</div>

<div class="pad">
<h3>Add / Lookup</h3>
<form class="create_form" name="ban" action="" method="post">
<input type="hidden" name="action" value="ip_ban">
<input type="hidden" name="auth" value="{{ viewer.auth }}">
<table cellpadding="6" cellspacing="1" border="0" class="layout border" width="100%">
    <tr>
        <th><label for="ip">IP address</label></th>
        <td>
            <textarea id="ip" name="ip" rows="2" cols="90" placeholder="An IP address {{ viewer.requestContext.remoteAddr }} or a range (e.g. {{ viewer.requestContext.remoteAddr }}/24) can be given to specify a range of addresses."></textarea>
        <br>Be careful with ranges below /24, you can quite easily block half the internet.
        </td>
    </tr>
    <tr>
        <th><label for="note">Note</label></th>
        <td>
            <input type="text" size="72" id="note" name="note">
        </td>
    </tr>
    <tr>
        <th>&nbsp;</th>
        <td>
            <input type="submit" name="add" value="Add">&nbsp;
            <input type="submit" name="search" value="Search">
        </td>
    </tr>
</table>
</form>
</div>

{% for ban in list %}
{%  if loop.first %}
{{ paginator.linkbox|raw }}
<div class="pad">
<table width="100%">
    <tr class="colhead">
        <td title="The IP addresses are specified as CIDRs">
            {{ header|column('ip') }}
        </td>
        <td>{{ header|column('note') }}</td>
        <td>{{ header|column('id_user') }}</td>
        <td>{{ header|column('created') }}</td>
        <td>{{ header|column('active') }}</td>
        <td>{{ header|column('total') }}</td>
    </tr>
{%  endif %}
    <tr class="row{{ cycle(['a', 'b'], loop.index0) }}">
        <td
{%- if ban.lo != ban.hi %} title="{{ ban.lo }}–{{ ban.hi }}"{% endif -%}
        ><a href="?action=ip-ban-edit&amp;id={{ ban.id }}">{{ ban.ip }}</a></td>
        <td>{{ ban.note }}</td>
        <td>{{ ban.id_user|user_url }}</td>
        <td>{{ ban.created|time_diff }}</td>
        <td>{% if ban.is_active %}Yes{% else %}No{% endif %}</td>
        <td>{{ ban.total|number_format }}</td>
    </tr>
{%  if loop.last %}
</table>
</div>
{{ paginator.linkbox|raw }}
{%  endif %}
{% endfor %}

{{ footer() }}
