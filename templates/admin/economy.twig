{#
Tools necessary for economic management
1. Current overall stats (!economy)
2. Statistical traffic trends in a graph
    a. All time / 1 year (whichever is smaller)
    b. 1 month
    c. 1 week
    d. 1 day
3. Freeleech analysis
    a. total download average during freeleech vs. normal conditions
    b. total stats of a freeleech - uploaded torrents, upload amount, download amount, snatches, etc.
4. Traffic trends over an account's life, on average
    a. at one week, one month, whatever (selectable range in weeks) - averages (up/down/ratio)
    b. given a selected timespan, average ratio (users who are 4-5 months old have X ratio)
    c. average date at which >50% of accounts with ratios >1 reach 1.0 and never dip below, stockpiling buffer
5. Raw numbers
    a. total torrents, seeders, leechers
    b. average seeds/leechs per torrent
    c. average snatches/user
    d. average seeding torrents/user
    e. users on ratio watch
6. Distribution graph of seedership vs. torrent percentage
    a. graph showing that the top 1% of torrents has 50% of seeders or whatever the numbers might be
7. Effects of economic changes
    a. number of users changed by ratio being changed
    b. project effects with intelligent mathematical analysis of a 24, 48 or 72 hour freeleech
#}

{% set download = eco.downloadTotal %}
{% set upload   = eco.uploadTotal %}
{% set userbase = eco.userTotal %}
{% set enabled  = eco.userTotal - eco.userDisabledTotal %}
{% set leechers = eco.leecherTotal %}
{% set peers    = eco.userPeerTotal %}
{% set seeders  = eco.seederTotal %}
{% set torrents = eco.torrentTotal %}

{% set snatches         = eco.snatchTotal %}
{% set snatches_overall = eco.snatchGrandTotal %}
{% set seeded_total     = torrent.torrentSeededTotal %}

{{ header('Economy') }}

<div class="thin">
    <div class="box">
        <div class="head">Overall stats</div>
        <div class="pad">
            <table>
            <tr>
            <td style="vertical-align:top; width:50%">
            <ul class="stats nobullet">
                <li><strong>Total upload: </strong>{{ upload|octet_size }}</li>
                <li><strong>Total download: </strong>{{ download|octet_size }}</li>
                <li><strong>Total buffer: </strong>{{ (upload - download)|octet_size }}</li>
                <br>
                <li><strong>Mean ratio: </strong>{{ ratio(upload, download) }}</li>
                <li><strong>Mean upload: </strong>{{ (upload / userbase)|octet_size }} ({{
                    (upload / userbase)|octet_size }} enabled)</li>
                <li><strong>Mean download: </strong>{{ (download / enabled)|octet_size }} ({{
                    (upload / enabled)|octet_size }} enabled)</li>
                <li><strong>Mean buffer: </strong>{{ ((upload - download) / userbase)|octet_size }} ({{
                    ((upload / enabled) / enabled)|octet_size }} enabled)</li>
                </li>
                <br>
                <li><strong>Total request bounty: </strong>{{ eco.bountyTotal|octet_size }}</li>
                <li><strong>Available request bounty: </strong>{{ eco.bountyAvailable|octet_size }}</li>
            </ul>
            </td>
            <td style="vertical-align:top; width:50%">
            <ul class="stats nobullet">
                <li>
                    <strong>Total Users: </strong>{{ eco.userTotal|number_format }}
                    <ul class="stats nobullet">
                        <li><strong>Disabled: </strong>{{ eco.userDisabledTotal|number_format }}</li>
                        <li><strong>Enabled: </strong>{{ (eco.userTotal - eco.userDisabledTotal)|number_format }}</li>
                    </ul>
                </li>
                <li>
                    <strong>Users with MFA: </strong>{{ eco.userMfaTotal|number_format }}
{% if eco.userTotal == 0 -%}
(0%)
{%- else -%}
({{ ((eco.userMfaTotal / eco.userTotal) * 100)|number_format(1) }}%)
{%- endif -%}
                </li>
                <br>
                <li><strong>BP in circulation: </strong>{{ eco.bonusTotal|number_format }}</li>
                <li><strong>BP stranded: </strong>{{ eco.bonusStrandedTotal|number_format }}</li>
                <br>
                <li><strong>Tokens in circulation: </strong>{{ eco.tokenTotal|number_format }}</li>
                <li><strong>Tokens stranded: </strong>{{ eco.tokenStrandedTotal|number_format }}</li>
            </ul>
            <br>
            <div>("Stranded" refers to disabled users)</div>
            </td>
            </tr>
            </table>
        </div>
    </div>
    <br>

    <div class="box">
        <div class="head">Swarms and snatches</div>
        <div class="pad">
            <table>
            <tr>
            <td style="vertical-align:top; width:50%">
            <ul class="stats nobullet">
                <li><strong>Total torrents: </strong>{{ torrent.torrentTotal|number_format }}</li>
                <li>
                    <strong>Total seeded torrents: </strong>{{ seeded_total|number_format }}
{% if torrent.torrentTotal == 0 -%}
(0%)
{%- else -%}
({{ ((seeded_total / torrent.torrentTotal) * 100)|number_format(1) }}%)
{%- endif -%}
                </li>
                <li><strong>Total single-seeded torrents: </strong>{{ torrent.singleSeedTotal|number_format }}
{% if torrent.torrentTotal == 0 -%}
(0%)
{%- else -%}
({{ ((torrent.singleSeedTotal / torrent.torrentTotal) * 100)|number_format(1) }}%)
{%- endif -%}
                </li>
                <li>
                    <strong>Total uploaders: </strong>{{ eco.uploaderTotal|number_format }}
{% if eco.userTotal == 0 -%}
(0%)
{%- else -%}
({{ ((eco.uploaderTotal / userbase) * 100)|number_format(1) }}% — {{
    ((eco.uploaderTotal / enabled) * 100)|number_format(1) }}% of enabled)
{%- endif -%}
                </li>
                <li>
                    <strong>Total users seeding: </strong>{{ eco.userPeerTotal|number_format }}
{% if eco.userPeerTotal == 0 -%}
(0%)
{%- else -%}
({{ ((eco.userPeerTotal / userbase) * 100)|number_format(1) }}% — {{
    ((eco.userPeerTotal / enabled) * 100)|number_format(1) }}% of enabled)
{%- endif -%}
                </li>
                <li><strong>Total seeders: </strong>{{ seeders|number_format }}</li>
                <li><strong>Total leechers: </strong>{{ leechers|number_format }}</li>
                <li><strong>Total peers: </strong>{{ (seeders + leechers)|number_format }}</li>
                <li><strong>Total snatches: </strong>{{ snatches_overall|number_format }}</li>
                <li><strong>Seeder/Leecher ratio: </strong>{{ ratio(seeders, leechers) }}</li>
                <li><strong>Seeder/Snatch ratio: </strong>{{ ratio(seeders, snatches_overall) }}</li>
                <li><strong>Seeder/Torrent ratio: </strong>{{ ratio(seeders, torrent.torrentTotal) }}</li>
                <br>
                <li><strong>Total users in at least one swarm: </strong>{{ peers|number_format }}</li>
                <li><strong>Mean leeching per user in at least one swarm: </strong>{{ (peers ? leechers / peers : 0)|number_format(2) }}</li>
                <li><strong>Mean snatches per user in at least one swarm: </strong>{{ (peers ? snatches / peers : 0)|number_format(2) }}</li>
            </ul>
            </td>
            <td style="vertical-align:top; width:50%">
            <ul class="stats nobullet">
                <li><strong>Mean seeders per torrent: </strong>{{ (torrents ? seeders / torrents : 0)|number_format(2) }}</li>
                <li><strong>Mean leechers per torrent: </strong>{{ (torrents ? leechers / torrents : 0)|number_format(4) }}</li>
                <li><strong>Mean snatches per torrent: </strong>{{ (torrents ? snatches / torrents : 0)|number_format(2) }}</li>
                <br>
                <li><strong>Mean seeding per user: </strong>{{ (seeders / enabled)|number_format(2) }}</li>
                <li><strong>Mean leeching per user: </strong>{{ (leechers / enabled)|number_format(2) }}</li>
                <li><strong>Mean snatches per user: </strong>{{ (snatches_overall / enabled)|number_format(2) }}</li>
            </ul>
            <br>
{% for user in eco.biggestSeederList %}
{%  if loop.first %}
            Users contributing the most seeds
            <ol>
{%  endif %}
                <li>{{ user.user_id|user_url }}: {{ user.total|number_format }}
                ({{ ((user.total / seeders) * 100)|number_format(2) }}%)
                </li>
{%  if loop.last %}
            </ol>
{%  endif %}
{% else %}
            No seeders to show in biggest seeder list
{% endfor %}
            </td>
            </tr>
            </table>
        </div>
    </div>
</div>
{{ footer() }}
