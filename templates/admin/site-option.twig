{{ header('Site Options') }}
<div class="header">
    <h1>Site Options</h1>
    <div class="box thin pad">Note: site options are created and removed via Phinx migrations.</div>
</div>
<table width="100%">
    <tr class="colhead">
        <td>Name</td>
        <td>Value</td>
        <td>Comment</td>
{% if viewer.permitted('admin_manage_permissions') %}
        <td>Manage</td>
{% endif %}
    </tr>
{% for opt in list %}
    <tr class="row{{ cycle(['a', 'b'], loop.index0) }}">
{%  if viewer.permitted('admin_manage_permissions') %}
    <form class="manage_form" name="site_option" action="" method="post">
        <td>{{ opt.name }}</td>
        <td><input type="text" size="6" name="value" value="{{ opt.value }}"></td>
        <td>{{ opt.comment }}</td>
        <td>
            <input type="hidden" name="action" value="site_options">
            <input type="hidden" name="auth" value="{{ viewer.auth }}">
            <input type="hidden" name="name" value="{{ opt.name }}">
            <input type="submit" name="submit" value="Edit">
        </td>
    </form>
{%  else %}
        <td>{{ opt.name }}</td>
        <td>{{ opt.value }}</td>
        <td>{{ opt.comment }}</td>
{%  endif %}
    </tr>
{% endfor %}
</table>
{{ footer() }}
