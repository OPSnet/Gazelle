{{ header(user.username ~ ' › Announce Key History', {'js': 'resolve-ip'}) }}
<div class="header">
    <h2><a href="{{ user.location }}">{{ user.username }}</a> › History › Announce keys</h2>
</div>
<div class="pad thin">
<div class="linkbox">
    <a href="?userid={{ user.id }}&amp;action=passwords">Password history</a>
</div>
<table width="100%">
    <tr class="colhead">
        <td>Previous</td>
        <td>Changed</td>
        <td>IP <a href="/userhistory.php?action=ips&amp;userid={{ user.id }}" class="brackets">H</a></td>
    </tr>
{% for change in user.history.announceKeyList %}
    <tr class="row{{ cycle(['a', 'b'], loop.index0) }}">
        <td>{{ change.previous }}</td>
        <td>{{ change.created|time_diff }}</td>
        <td>{{ change.ip }} <a href="user.php?action=search&amp;ip_history=on&amp;ip={{
            change.ip }}" class="brackets tooltip" title="Search">S</a>
            <span class="resolve-ipv4" data-ip="{{ change.ip }}">Resolving...</span>
        </td>
    </tr>
{% endfor %}
</table>
</div>
{{ footer() }}
