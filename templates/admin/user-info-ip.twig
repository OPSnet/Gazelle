{% from 'macro/ipv4.twig' import asn, ip_search %}
<tr><th colspan="7"><br>{{ title }}</th></tr>
{% for r in info %}
    {% if loop.first %}
<tr>
    <th>IP</th>
    <th>CC</th>
    <th>First seen</th>
    <th>Last seen</th>
    <th>ASN</th>
    <th>rDNS</th>
    <th></th>
</tr>
    {% endif %}
<tr class="row{{ cycle(['a', 'b'], loop.index0) }}">
    <td>{{ ip_search(r.ip, withTracker) }}</td>
    <td>{{ r.cc }}</td>
    <td>{{ r.first_seen.format('Y-m-d H:i:s.vP') }}</td>
    <td>{{ r.last_seen.format('Y-m-d H:i:s.vP') }}</td>
    <td>{{ asn(r.name, r.n) }}</td>
    <td><span class="resolve-ipv4" data-ip="{{ r.ip }}">Resolving...</span></td>
    <td></td>
</tr>
{% else %}
<tr class="row{{ cycle(['a', 'b'], loop.index0) }}">
    <td colspan="7">no records</td>
</tr>
{% endfor %}
