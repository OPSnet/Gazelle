{{ header('Scheduler Statistics', {'js': 'vendor/highcharts,vendor/highcharts_custom'}) }}
<div class="header">
<h2><a href="?action=periodic&amp;mode=view">Scheduler</a> › Statistics</h2>
</div>
{% include 'admin/scheduler/links.twig' with {'can_edit': viewer.permitted('admin_periodic_task_manage')} only %}
<div class="box pad">
    <table>
        <tr class="colhead">
            <td>Runs</td>
            <td>Duration</td>
            <td>Processed</td>
            <td>Events</td>
            <td>Errors</td>
        </tr>
        <tr>
            <td>{{ stats.totals.run_total|number_format }}</td>
            <td>{{ stats.totals.duration|number_format }} ms</td>
            <td>{{ stats.totals.item_total|number_format }}</td>
            <td>{{ stats.totals.event_total|number_format }}</td>
            <td>{{ stats.totals.error_total|number_format }}</td>
        </tr>
    </table>
    <br>
    <div id="task-averages" style="width: 100%; height: 500px;"></div>
    <br>
    <div>
        <div id="hourly-totals" style="width: 49.5%; height: 350px; float: left; padding-right: 1%"></div>
        <div id="daily-totals" style="width: 49.5%; height: 350px;"></div>
    </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function() {
    Highcharts.chart('task-averages', {
        chart: { type: 'column' },
        title: { text: 'Task Averages' },
        credits: { enabled: false },
        xAxis: {
            categories: {{ stats.tasks.category|json_encode|raw }},
        },
        yAxis: [
            {
                title: { text: 'Duration' },
                type: 'logarithmic',
            },
            {
                title: { text: 'Items' },
                type: 'logarithmic',
                opposite: true,
            }
        ],
        series: [
            {
                data: {{ stats.tasks.duration|json_encode }},
                name: 'Duration',
                type: 'column',
                yAxis: 0
            },
            {
                data: {{ stats.tasks.item_total|json_encode }},
                name: 'Processed',
                type: 'column',
                yAxis: 1
            }
        ]
    });

    Highcharts.chart('hourly-totals', {
        chart: { type: 'column' },
        title: { text: 'Hourly' },
        credits: { enabled: false },
        xAxis: {
            categories: {{ stats.hourly.category|json_encode|raw }},
        },
        yAxis: [
            {
                title: { text: 'Duration' }
            },
            {
                title: { text: 'Items' },
                opposite: true
            }
        ],
        series: [
            {
                data: {{ stats.hourly.duration|json_encode }},
                name: 'Duration',
                type: 'column',
                yAxis: 0
            },
            {
                data: {{ stats.hourly.item_total|json_encode }},
                name: 'Processed',
                type: 'column',
                yAxis: 1
            }
        ]
    });

    Highcharts.chart('daily-totals', {
        chart: { type: 'column' },
        title: { text: 'Daily' },
        credits: { enabled: false },
        xAxis: {
            categories: {{ stats.daily.category|json_encode|raw }},
        },
        yAxis: [
            {
                title: { text: 'Duration' }
            },
            {
                title: { text: 'Items' },
                opposite: true
            }
        ],
        series: [
            {
                data: {{ stats.daily.duration|json_encode }},
                name: 'Duration',
                type: 'column',
                yAxis: 0
            },
            {
                data: {{ stats.daily.item_total|json_encode }},
                name: 'Processed',
                type: 'column',
                yAxis: 1
            }
        ]
    });

});
</script>
{{ footer() }}
