{% if search.isFiltered %}
<div class="box pad">
{%  set result  = search.page(paginator.limit, paginator.offset) %}
{%  set columns = result[0]|length %}
{%  set heading = search.heading %}
{%  for r in result %}
{%    if loop.first %}
  <h3>Users matched: {{ search.total|number_format }}</h3>
{{      paginator.linkbox|raw }}
  <table>
    <tr>
{%      for col in 0 .. (columns-1) %}
{%        set field = 'c' ~ col %}
      <th>{{ heading.alias(field)|raw }}</th>
{%      endfor %}
    </tr>
{%    endif %}
    <tr>
{%    for col in 0 .. (columns-1) %}
      <td>
{%-     set field = 'c' ~ col %}
{%      if r[field] is instanceof('\\DateTimeImmutable') %}
{{          r[field]|date('Y-m-d H:i:s') -}}
{%      elseif heading.aliasField(field) in ['username', 'inviter'] %}
{{          r[field]|user_url -}}
{%      elseif heading.aliasField(field) == 'enabled' %}
{%          if r[field] == enum('Gazelle\\Enum\\UserStatus').disabled.value %}🚫
{%          elseif r[field] == enum('Gazelle\\Enum\\UserStatus').unconfirmed.value %}❓
{%          else %}✅
{%          endif %}
{%      elseif heading.aliasField(field) == 'mfa' %}
{%          if r[field] %}✅{% else %}·{% endif %}
{%      elseif heading.aliasField(field) == 'staffnote' %}
{{          r[field]|join('<br>')|raw }}
{%      elseif heading.aliasField(field) == 'disable' %}
{{          r[field]|default([])|map(attr => attr|replace({'disable-': ''}))|join(', ') }}
{%      elseif heading.aliasField(field) ends with 'gb' %}
{{          r[field]|octet_size -}}
{%      elseif heading.aliasField(field) in ['joined', 'lastseen'] %}
{{          r[field]|time_diff -}}
{%      elseif heading.aliasField(field) in [
            'bptotal', 'fltoken', 'invited', 'leech',
            'requestcreate', 'seedhour', 'seeding', 'snatch',
            'snatch-uniq', 'tdownload', 'tdownload-uniq', 'uploads',
        ] %}
{{          r[field]|number_format-}}
{%      else %}
{{          r[field] -}}
{%      endif -%}
      </td>
{%    endfor %}
    </tr>
{%    if loop.last %}
  </table>
{%    endif %}
{%  endfor %}
</div>
{{  paginator.linkbox|raw }}
{%  if viewer.permitted('admin_site_debug') %}
{%  endif %}
</div>
{% endif %}
{{ footer() }}
