{% set is_reported = reported_torrent.id == torrent.id %}
<span data-id="{{ torrent.id }}">
    {{ torrent.groupLink|raw }} {{ torrent.shortLabelLink|raw }} ({{ torrent.size|octet_size }})
    <br>{{ torrent.edition }}
{% if not torrent.isDeleted %}
    <br>
    <a href="{{ torrent.downloadLocation(viewer) }}" title="Download" class="brackets tooltip">DL</a>
    <a class="brackets tooltip view-download" title="View the list of users that have clicked the &quot;DL&quot; button.">Downloaders</a>
    <a class="brackets tooltip view-snatch" title="View the list of users that have reported a snatch to the tracker.">Snatchers</a>
    <a class="brackets tooltip view-peer" title="View the list of peers in this torrent's swarm.">Peers</a>
{% else %}
    <span>(deleted torrent)</span><br>
{% endif %}
    <a class="brackets tooltip view-filelist" title="View the list of files in this torrent">Contents</a>
    <div id="viewlog_{{ torrent.id }}" class="hidden"></div>
    <div id="peers_{{ torrent.id }}" class="hidden"></div>
    <div id="downloads_{{ torrent.id }}" class="hidden"></div>
    <div id="snatches_{{ torrent.id }}" class="hidden"></div>
    <div id="files_{{ torrent.id }}" class="hidden">
        <table class="filelist_table">
            <tr class="colhead_dark">
                <td>
                    <div class="filelist_title" style="float: left;">File Names</div>
                    <div class="filelist_path" style="float: right;">{{ torrent.path|default('.') }}</div>
                </td>
                <td class="nobr" style="text-align: right">
                    <strong>Size</strong>
                </td>
            </tr>
            {% for f in torrent.fileList %}
                <tr><td>{{ f.name }}</td><td class="number_column nobr">{{ f.size|octet_size }}</td></tr>
            {% endfor %}
        </table>
    </div>
{% if is_reported %}
    <br><span class="report_reporter">reported by {{ report.reporterId|user_url }} {{ report.created|date('Y-m-d H:i:s')|time_diff }} for the reason: <strong>{{ report.reportType.name }}</strong></span>
{% endif %}
    <br>uploaded by {{ torrent.uploaderId|user_url }} on
    <span title="{{ torrent.created|time_diff(3, false) }}">{{ torrent.created }}
{% if not is_reported %} (
{%- if torrent.created|date('c') < reported_torrent.created|default('2000-01-01 00:00:00')|date('c') -%}
    older upload{%  else %}more recent upload{% endif %})
{% endif %}
    </span>
{% if not torrent.isDeleted %}
    <br>Last action: {{ torrent.lastActiveDate|default('Never') }}
{% endif %}
    <br>
    <span class="report_torrent_file_ext">Audio files present:
{% for ext, total in torrent.fileListPrimaryMap -%}
{%- if loop.first %}<span class="file_ext_map">{% else %}, {% endif -%}
        {{ ext }}: {{ total|number_format }}
{%- if loop.last %}</span>{% endif -%}
{% else %}
    <span class="file_ext_none">none</span>
{% endfor %}
    </span>
{% if torrent.description %}
    <br>
{%  if is_reported %}
    <div class="report_torrent_info" title="Release description of reported torrent"
{%  else %}
    <div class="report_other_torrent_info" title="Release description of other torrent"
{%  endif %}>Release info: <blockquote>{{ torrent.description|bb_format }}</blockquote></div>
{% endif %}
</span>
