{% macro renderDetails(collection) %}
<ul class="nobullet logdetails">
{% for riplog in collection.riplogList %}
{%  if riplog.isAdjusted %}
    <li>Log adjusted by {{ riplog.adjusterUserId|user_url
        }} from score {{ riplog.score }} to {{ riplog.scoreAdjusted }}
{%  if riplog.adjustmentReason %} (reason: {{ riplog.adjustmentReason }}){% endif %}
    </li>
{%  endif %}
{%  for key, status in riplog.adjustmentList %}
{%      if status %}
{%          if key == 'tracks' %}
{%              set status = status|join(', ') %}
{%          endif %}
    <li>{{ status }}</li>
{%      endif %}
{%  endfor %}
    <li>
        <span class="nobr"><strong>Logfile #{{ riplog.id }}</strong>: </span>
        <a onclick="BBCode.spoiler(this);" class="brackets">Show</a><blockquote class="hidden">
            <pre class="logfile_html">{{ riplog.html.get|raw }}</pre>
        </blockquote>
    </li>
{% else %}
    <li class="nobr">No logs</li>
{% endfor %}
</ul>
{% endmacro %}
<table class="logfile_cmp">
    <tr>
        <td>Reported</td>
        <td>Relevant</td>
    </tr>
    <tr>
        <td style="vertical-align: top; max-width: 500px; width: 50%">
{{ _self.renderDetails(report.torrentRiplogCollection) }}
        </td>
        <td style="vertical-align: top; max-width: 500px; width: 50%">
{% for o in report.otherRiplogCollection %}
{{  _self.renderDetails(o) }}
{% endfor %}
        </td>
    </tr>
</table>
