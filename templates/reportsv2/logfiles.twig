{% macro renderDetails(details) %}
<ul class="nobullet logdetails">
{% for log_id, info in details %}
{%  if info.adjustment %}
{%      set adj = info.adjustment %}
    <li>Log adjusted by {{ adj.user.link|default('System')
        }} from score {{ adj.score }} to {{ adj.adjusted }}
        {%- if adj.reason %} (reason: {{ adj.reason }}){% endif %}
    </li>
{%  endif %}
{%  for key, status in info.status %}
{%      if status %}
{%          if key == 'tracks' %}
{%              set status = status|join(', ') %}
{%          endif %}
    <li>{{ status }}</li>
{%      endif %}
{%  endfor %}
    <li>
        <span class="nobr"><strong>Logfile #{{ log_id }}</strong>: </span>
        <a onclick="BBCode.spoiler(this);" class="brackets">Show</a><blockquote class="hidden">
            <pre class="logfile_html">{{ info.html_log|raw }}</pre>
        </blockquote>
    </li>
{% else %}
    <li class="nobr">No logs</li>
{% endfor %}
</ul>
{% endmacro %}
<table class="logfile_cmp">
    <tr>
        <td>Reported</td>
        <td>Relevant</td>
    </tr>
    <tr>
        <td style="vertical-align: top; max-width: 500px; width: 50%">
{{ _self.renderDetails(log_details) }}
        </td>
        <td style="vertical-align: top; max-width: 500px; width: 50%">
{{ _self.renderDetails(other_details) }}
        </td>
    </tr>
</table>
