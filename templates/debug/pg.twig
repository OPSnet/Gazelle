{% set nr = pg.queryList|length %}
{% for q in pg.queryList %}
{%  if loop.first %}
<details>
<summary>{{ pg.queryList|length|number_format }} Postgresql {% if nr == 1 %}query{% else %}queries{% endif %} ({{
    (pg.totalDuration * 1000)|number_format(2) }} ms) (mean: {{
    ((pg.totalDuration * 1000)/nr)|number_format(5) }} ms)</summary>
<table class="debug-table">
    <tr class="colhead">
        <td>Query</td>
        <td>Metric</td>
        <td>Duration</td>
    </tr>
{%  endif %}
    <tr class="row{{ cycle(['a', 'b'], loop.index0) }}">
        <td class="debug_data debug_query_data"><pre>{{ q.query|nl2br }}
{%  if q.args %}
        -- {{ q.args|join(', ') }}
{%  endif %}
        </pre>
        <br><a class="brackets" href="tools.php?action=db_sandbox&amp;src=pg&amp;debug={{
            {"query": q.query, "args": q.args}|json_encode|b64 }}">Inspect</a>
        </td>
        <td class="debug_info" style="width: 130px;">{{ q.metric }}</td>
        <td class="debug_info debug_query_time" style="width: 130px;">{{ (q.duration * 1000)|number_format(5) }} ms</td>
    </tr>
{%  if loop.last %}
</table>
</details>
{%  endif %}
{% endfor %}
{% for e in pg.errorList %}
{%  if loop.first %}
<details>
<summary>{{ pg.errorList|length|number_format }} Postgresql error{{ pg.errorList|length|plural }}</summary>
<table class="debug-table">
    <tr class="colhead">
        <td>Error</td>
    </tr>
{%  endif %}
    <tr class="row{{ cycle(['a', 'b'], loop.index0) }}">
        <td class="debug_data debug_query_data"><pre>{{ e.query|nl2br }}
{%  if e.args %}
    -- {{ e.args|join(', ') }}
{%  endif %}
            </pre>
        </td>
    </tr>
{%  if loop.last %}
</table>
</details>
{%  endif %}
{% endfor %}
