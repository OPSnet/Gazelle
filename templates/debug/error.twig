{% for error in list %}
{%  if loop.first %}
<details>
<summary>{{ list|length|number_format }} Error{{ list|length|plural }}</summary>
<table class="debug-table">
{%  endif %}
    <tr class="row{{ cycle(['a', 'b'], loop.index0) }}">
        <td class="debug_info debug_error_call">
            {{ error.2 }}({{ error.3 }})
        </td>
        <td class="debug_data debug_error_data">
            {{ error.0 }}
        </td>
        <td>
            {{ error.1 }}
        </td>
    </tr>
{%  if loop.last %}
</table>
</details>
{%  endif %}
{% endfor %}
