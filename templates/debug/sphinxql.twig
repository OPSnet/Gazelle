{% for query in list %}
{%  if loop.first %}
{%      set nr = list|length %}
<details>
<summary>{{ nr }} Sphinx search{{ nr|plural('es') }} ({{
    (time * 1000)|number_format(2) }} ms)</summary>
<table class="debug-table">
{%   endif %}
    <tr class="row{{ cycle(['a', 'b'], loop.index0) }}">
        <td class="debug_data debug_sphinxql"><pre>{{ query.0 }}</pre></td>
        <td class="rowa debug_info debug_sphinx_time" style="width: 130px;">{{ (query.1 * 1000)|number_format(5) }} ms</td>
    </tr>
{%  if loop.last %}
</table>
</details>
{%  endif %}
{% endfor %}
