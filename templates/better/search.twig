{%- from 'macro/form.twig' import selected -%}
{%- macro yes_no(value) -%}
    {%- if value -%}
        <strong class="important_text">NO</strong>
    {%- else -%}
        <strong class="important_text_alt">YES</strong>
    {%- endif -%}
{%- endmacro -%}
{{ header('Transcode Search') }}
<div class="thin">
    <h2>Transcodes</h2>
{% include 'better/links.twig' only %}
    <form class="search_form" name="transcodes" action="" method="get">
        <input type="hidden" name="method" value="transcode">
        <table cellpadding="6" cellspacing="1" border="0" class="border" width="100%">
            <tr>
                <td class="label"><strong>Filter</strong></td>
                <td>
                    <select name="filter">
{% for filterCase in enum('Gazelle\\Enum\\BetterFilter').cases %}
                        <option value="{{ filterCase.name }}"{{ selected(filter == filterCase.name) }}>{{ filterCase.name|ucfirst }}</option>
{% endfor %}
                    </select>
                    <select name="target">
{% for encodingCase in enum('Gazelle\\Enum\\BetterEncoding').cases %}
                        <option value="{{ encodingCase.value }}"{{ selected(target == encodingCase.value) }}>{{ encodingCase.value|ucfirst }} missing</option>
{% endfor %}
                    </select>
                </td>
            </tr>
            <tr>
                <td class="label"><strong>Search</strong></td>
                <td>
                    <input type="search" name="search" size="60" value="{{ search }}">
                </td>
            </tr>
            <tr><td>&nbsp;</td><td><input type="submit" value="Search"></td></tr>
        </table>
    </form>
    <h3>About</h3>
    <div class="box pad" style="padding: 10px 10px 10px 20px;">
        <p>
            This page lists {{ page|length }} random transcodable perfect FLACs matching the options you selected above. The following numbers tell you something about the torrents currently listed below and can change if you reload.<br><br>

            Number of perfect FLACs you can transcode: {{ total.all|number_format }}<br>
            Number of missing V0 transcodes: {{ total.total_v0|number_format }}<br>
            Number of missing 320 transcodes: {{ total.total_320|number_format }}<br>
            Total missing transcodes: {{ (total.total_v0 + total.total_320)|number_format }}<br>
{% if viewer.permitted('zip_downloader') and source|length > 0 %}
            <br>
            <br>
{%  set id_list = source|join(',') %}
            <a class="brackets" href="torrents.php?action=collector&amp;title=better&amp;ids={{ id_list }}&amp;sig={{ viewer.hashHmac('collector', id_list) }}" onclick="return confirm('If you do not have the content, your ratio WILL be affected; be sure to check the size of all torrents before downloading.');">Download All</a>
{% endif %}
        </p>
    </div>
    <h3>List</h3>
    <table width="100%" class="torrent_table">
        <tr class="colhead">
            <td>Torrent</td>
            {% if target != '320' %}<td>V0</td>{% endif %}
            {% if target != 'v0' %}<td>320</td>{% endif %}
        </tr>
{% for item in list %}
    {% if item.torrent %}
        <tr>
            <td>
                <span class="torrent_links_block">
                    {{ item.torrent.link|raw }}
                </span>
            </td>
            {% if target != '320' %}<td>{{ _self.yes_no(item.want_v0) }}</td>{% endif %}
            {% if target != 'v0' %}<td>{{ _self.yes_no(item.want_320) }}</td>{% endif %}
        </tr>
    {% endif %}
{% else %}
        <tr><td colspan="4">No results found!</td></tr>
{% endfor %}
    </table>
</div>
{{ footer() }}
