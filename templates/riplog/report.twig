{% if checker.getChecksumState != constant('OrpheusNET\\Logchecker\\Check\\Checksum::CHECKSUM_OK') %}
    <blockquote>
{%  if pasted is not defined or pasted == false %}
        <strong>Trumpable For:</strong>
        <br><br>
{%      if checker.getChecksumState == constant('OrpheusNET\\Logchecker\\Check\\Checksum::CHECKSUM_MISSING') %}
                No Checksum(s)
{%      elseif checker.getChecksumState == constant('OrpheusNET\\Logchecker\\Check\\Checksum::CHECKSUM_INVALID') %}
                Invalid Checksum(s)
{%      endif %}
{%  else %}
            Checksums of pasted log files cannot be verified, as the character encoding can change during copy-pasting.
{%  endif %}
    </blockquote>
{% endif %}

{% if checker.getScore == 100 %}
{%  set color = '#418B00' %}
{% elseif checker.getScore  > 90 %}
{%  set color = '#74C42E' %}
{% elseif checker.getScore  > 75 %}
{%  set color = '#FFAA00' %}
{% elseif checker.getScore  > 50 %}
{%  set color = '#FF5E00' %}
{% else %}
{%  set color = '#FF0000' %}
{% endif %}
    <blockquote>
        <strong>Score:</strong> <span style="color:{{ color }}">{{ checker.getScore }}</span> (out of 100)
    </blockquote>
    <blockquote>
        <h3>Log validation report:</h3>
        <ul>
{% for detail in checker.getDetails %}
            <li>{{ detail }}</li>
{% endfor %}
        </ul>
    </blockquote>
    <blockquote>
        <pre>{{ checker.getLog|raw }}</pre>
    </blockquote>
