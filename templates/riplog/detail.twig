<tr class="log_section">
    <td>
{% set nth %}
{% if total > 1 %} {{ n }}/{{ total }}{% endif %}
{% endset %}
{% set arrows %}
{%  if n > 1 %} <a title="Previous riplog" href="#riplog-{{ n - 1 }}">🡹</a>{% endif %}
{%  if total > 1 and n < total %} <a title="Next riplog" href="#riplog-{{ n + 1 }}">🡻</a>{% endif %}
{% endset %}
{%  if viewer.permitted('users_mod') %}
        <div style="padding: 10px; float: right">
{%      if riplog.file.exists %}
        <a class="brackets" href="torrents.php?action=editlog&amp;torrentid={{
            riplog.torrent.id }}&amp;logid={{ riplog.id }}">Edit Log</a>
{%      endif %}
        <a class="brackets" onclick="return confirm('Are you sure you want to deleted this log? There is NO undo!');"
            href="torrents.php?action=removelog&amp;torrentid={{
            riplog.torrent.id }}&amp;logid={{ riplog.id }}&amp;auth={{ viewer.auth }}">Delete Log</a>
        </div>
{%  endif %}
{%  if riplog.file.exists %}
        <div style="padding: 10px; float: left"><a class="brackets" name="riplog-{{ n }}" href="view.php?type=riplog&amp;id={{
            riplog.torrent.id }}.{{ riplog.id }}" target="_blank">View Raw Log{{ nth }}</a>{{ arrows }}</div>
{%  else %}
        <div style="padding: 10px; float: left">Log not found in storage{{ arrows }}</div>
{%  endif %}
    <br>
    <br clear="both">
{%  if (not riplog.isAdjusted and not riplog.isChecksumOk) or (riplog.isAdjusted and not riplog.isAdjustedChecksumOk) %}
    <div style="margin-left: 40px">
        <strong>Trumpable for:</strong>
        <br><br>
        Bad/No Checksum(s)
    </div>
{%  endif %}
{%  if riplog.adjustmentList %}
    <div style="margin-left: 40px">
        <div style="margin-top: 10px">Log adjusted by {{ riplog.adjusterUserId|user_url }}.</div>
{%      if riplog.scoreAdjuested != riplog.score %}
        Score changed from {{ riplog.score }} to {{ riplog.scoreAdjusted }}
{%      endif %}
{%      if riplog.adjustmentReason %}
        <div>Reason: {{ riplog.adjustmentReason }}</div>
{%      endif %}
        <div style="margin-top: 10px"><strong>Adjustment Details:</strong></div>
        <ul style="margin-top: 0">
{%      for label, detail in riplog.adjustmentList %}
{%          if label != 'tracks' %}
            <li>{{ detail }}</li>
{%          endif %}
{%      endfor %}
        </ul>
    </div>
{%  endif %}
{%  for detail in riplog.report %}
{%      if loop.first %}
    <blockquote><strong>{% if riplog.isAdjusted %}Final {% endif %}Log Validation Report:</strong>
    <ul class="nobullet">
{%      endif %}
            <li>{{ detail }}</li>
{%      if loop.last %}
    </ul>
    </blockquote>
{%      endif %}
{%  endfor %}
{%  if riplog.html.exists %}
    <blockquote>
        <pre style="white-space:pre-wrap">{{ riplog.html.get|raw }}</pre>
    </blockquote>
{%  endif %}
    </td>
</tr>

