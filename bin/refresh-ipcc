#! /usr/bin/env php
<?php

namespace Gazelle;

require __DIR__ . '/../lib/bootstrap.php';

$db      = DB::DB();
$asn     = new Search\ASN();
$userMan = new Manager\User();

$db->prepared_query("
    SELECT ID FROM users_main
");

$n = 0;
foreach ($db->collect(0) as $id) {
    $user = $userMan->findById($id);
    if (is_null($user)) {
        continue;
    }
    $user->setField('ipcc', $asn->countryISO($user->ipaddr()))->modify();
    ++$n;
}

echo "$n users processed\n";
