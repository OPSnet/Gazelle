#! /usr/bin/env php
<?php

declare(strict_types=1);

namespace Gazelle;

require __DIR__ . '/../../lib/bootstrap.php';

$pg = new DB\Pg(PG_RW_DSN);
$pg->begin();

$pg->query("
    truncate table request_artist
");
$inserted = $pg->query(
<<<END_SQL
    insert into request_artist
    select "RequestID",
        "AliasID",
        artist_role_id,
        "UserID",
        created
    from relay.requests_artists
END_SQL
);

$pg->commit();

echo "request_artist: $inserted inserted\n";
